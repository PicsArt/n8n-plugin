{
  "name": "@picsart/n8n-nodes-picsart-creative-apis",
  "version": "5.4.8",
  "description": "n8n nodes to integrate Picsart API: generate images from text, remove backgrounds, and enhance images with AI-powered tools.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "picsart",
    "image-processing",
    "image-generation",
    "text2image",
    "generate-images-from-prompt",
    "generate-stickers-from-prompt",
    "image2video",
    "background-removal",
    "image-enhancement",
    "upscale",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://github.com/PicsArt/n8n-plugin#readme",
  "author": {
    "name": "Picsart",
    "email": "picsart-enterprise@picsart.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PicsArt/n8n-plugin.git",
    "directory": "n8n-nodes-picsart-creative-apis"
  },
  "bugs": {
    "url": "https://github.com/PicsArt/n8n-plugin/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && node ./node_modules/typescript/bin/tsc && node scripts/copy-icons.cjs",
    "dev": "node ./node_modules/typescript/bin/tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -- --config .eslintrc.prepublish.js",
    "release": "bash release.sh",
    "release:patch": "bash release.sh patch",
    "release:minor": "bash release.sh minor",
    "release:major": "bash release.sh major",
    "test": "node --test tests/*.test.cjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PicsartApi.credentials.js",
      "dist/credentials/PicsartOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PicsartImage/PicsartImage.node.js",
      "dist/nodes/PicsartGeneration/PicsartGeneration.node.js",
      "dist/nodes/PicsartVideo/PicsartVideo.node.js",
      "dist/nodes/ExtractImageColors/ExtractImageColors.node.js",
      "dist/nodes/PicsartAudio/PicsartAudio.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "2.0.0",
    "n8n-workflow": "2.16.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "form-data@4": "^4.0.6",
      "lodash@4": "^4.18.1",
      "n8n-workflow@2.16.0>uuid": "11.1.1",
      "n8n-workflow@2.16.0>zod": "4.6.6",
      "minimatch@>=7 <11": "11.0.1"
    },
    "patchedDependencies": {
      "n8n-workflow@2.16.0": "patches/n8n-workflow@2.16.0.patch"
    }
  }
}
